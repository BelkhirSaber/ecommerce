<!DOCTYPE html>
<html lang="fr">

<head>
    {% include 'admin/partials/head.twig' %}
</head>

{% set base_path = constant('RACINE') ? '/' ~ constant('RACINE') : '' %}

<body class="hold-transition sidebar-mini layout-fixed">

<div class="wrapper">

    {% include 'components/admin/header.twig' %}
    {% include 'components/admin/sidebar.twig' %}

    <div class="content-wrapper">

        {% include 'admin/partials/breadcrumbs.twig' %}

        <section class="content">
            <div class="container-fluid">
                {% block content %}{% endblock %}
            </div>
        </section>

    </div>

    {% include 'components/admin/footer.twig' %}

</div>

{% include 'admin/partials/scripts.twig' %}

</body>
</html>
