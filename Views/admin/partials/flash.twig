{% if flash_success is defined and flash_success is not empty %}
<div class="alert alert-success alert-dismissible">
    <button type="button" class="close" data-dismiss="alert">&times;</button>
    {{ flash_success }}
</div>
{% endif %}

{% if flash_error is defined and flash_error is not empty %}
<div class="alert alert-danger alert-dismissible">
    <button type="button" class="close" data-dismiss="alert">&times;</button>
    {{ flash_error }}
</div>
{% endif %}

{% if flash_warning is defined and flash_warning is not empty %}
<div class="alert alert-warning alert-dismissible">
    <button type="button" class="close" data-dismiss="alert">&times;</button>
    {{ flash_warning }}
</div>
{% endif %}

{% if flash_info is defined and flash_info is not empty %}
<div class="alert alert-info alert-dismissible">
    <button type="button" class="close" data-dismiss="alert">&times;</button>
    {{ flash_info }}
</div>
{% endif %}
